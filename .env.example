# ============================================
# Test Platform - Environment Variables
# ============================================

# Application Configuration
COMPANY_NAME="Test Platform"
APP_NAME=test-platform
APP_PORT=3000
NODE_ENV=development
NITRO_PORT=3000
BUILD_TARGET=development

# ============================================
# Database Configuration
# ============================================
# Для standalone режима (docker-compose.standalone.yml) эти переменные
# автоматически используются для создания БД в контейнере
# Для локальной разработки без Docker используйте DATABASE_URL напрямую
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test_platform
POSTGRES_PORT=5432

# Database URL
# Для Docker Compose: будет автоматически сформирован из переменных выше
# Для локальной разработки: раскомментируйте и настройте
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/test_platform"

# ============================================
# Session Configuration
# ============================================
# ВАЖНО: Измените этот пароль в production!
# Минимум 32 символа
NUXT_SESSION_PASSWORD=a-random-password-with-at-least-32-characters-change-in-production

# ============================================
# Telegram Integration (опционально)
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_CHANNEL_USERNAME=your_channel_username

# ============================================
# SMTP Configuration (опционально)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME="Test Platform"

# ============================================
# Admin User (для seed данных)
# ============================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
